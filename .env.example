# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (local PostgreSQL via Docker Compose) ------------------------
# Started with `docker compose up -d` (see docker-compose.yml). Used by the
# app at runtime (through the `pg` driver adapter) and by Prisma Client.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/facturacion_cleverchamba"

# Used by Prisma CLI commands (migrate, db pull, studio). Locally this is
# the same instance as DATABASE_URL. In production, behind a connection
# pooler (e.g. Supabase's pgbouncer), this would instead be the direct,
# non-pooled connection, since migrations need a session-mode connection.
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/facturacion_cleverchamba"

# --- Supabase project (not used for the database right now) ---------------
# Unrelated to DATABASE_URL/DIRECT_URL above, which now point at local
# Postgres. Not currently read anywhere in the code; kept here only in case
# Supabase's own services (auth, storage, etc.) are adopted later.
# Public project URL and anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# Service role key (server-side only, NEVER expose to the client/browser).
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# --- App -------------------------------------------------------------------
# Base URL of this app, used for building absolute links (emails, webhooks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database seed (development only) --------------------------------------
# Default password hashed (bcrypt) for the dev users created by
# `prisma/seed.ts`. Required — the seed refuses to run without it. Never a
# real/production password; never logged anywhere by the seed script.
SEED_DEFAULT_PASSWORD=""

# --- Ventas: pago con tarjeta -----------------------------------------------
# The BankAccount.id every CARD (tarjeta) payment on a sale is credited to --
# every card terminal settles into this one account, so a seller can never
# pick a different one. Must be the id of a real, currently-active row in
# /cuentas-bancarias. See sale-service.ts#getCardPaymentBankAccountForSaleForm.
CARD_PAYMENT_BANK_ACCOUNT_ID="047b1291-dc63-4575-89f1-0b855b08a6b2"
