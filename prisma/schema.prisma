// Prisma schema for the CleverChamba academy sales/payments/invoicing system.
// Connection settings live in prisma.config.ts (DATABASE_URL / DIRECT_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are configured in prisma.config.ts, not here.
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserRole {
  ADMIN
  ACCOUNTANT
  SELLER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  COURSE
  MENTORING
  WORKSHOP
  CONSULTING
}

enum SaleStatus {
  ACTIVE
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentValidationStatus {
  PENDING_VALIDATION
  APPROVED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  // Distinct from BANK_TRANSFER: a physical/direct deposit into the
  // account rather than an electronic transfer. Added for the per-cuota
  // "forma de pago" selector (see sale-form.tsx's cuotas section) --
  // existing payments never use this value.
  DEPOSIT
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  URGENT
  SUCCESS
}

enum InvestmentStatus {
  PENDING_VALIDATION
  ACTIVE
  MATURED
  COMPLETED
  REJECTED
  CANCELLED
}

enum BankTransactionType {
  INCOME
  EXPENSE
}

// =========================================================================
// MODELS
// =========================================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // --- Personal profile fields (self-service, editable only by the user
  // themselves via /perfil). None of these affect auth or RBAC. ---
  avatarUrl String? // Relative path under /uploads/avatars, e.g. "/uploads/avatars/<id>-<uuid>.webp".
  phone     String?
  country   String?
  city      String?

  // Sales this user made as a seller.
  salesAsSeller Sale[] @relation("SaleSeller")

  // Payments this user registered (recorded on behalf of a customer).
  paymentsRegistered Payment[] @relation("PaymentRegisteredBy")

  // Payments this user validated (approved or rejected).
  paymentsValidated Payment[] @relation("PaymentValidatedBy")

  // Payment receipts this user uploaded.
  receiptsUploaded PaymentReceipt[] @relation("ReceiptUploadedBy")

  // Sale receipts this user uploaded (see SaleReceipt).
  saleReceiptsUploaded SaleReceipt[] @relation("SaleReceiptUploadedBy")

  notifications     Notification[]
  sessions          Session[]
  // Customers this user (a SELLER) is the assigned/responsible seller for.
  assignedCustomers Customer[]     @relation("CustomerAssignedSeller")

  // Investments this user (a SELLER) captured/is responsible for.
  investmentsAsSeller Investment[] @relation("InvestmentSeller")

  // Investments this user validated (approved or rejected).
  investmentsValidated Investment[] @relation("InvestmentValidatedBy")

  // Investments this user (ADMIN) cancelled early.
  investmentsCancelled Investment[] @relation("InvestmentCancelledBy")

  // Investment receipts/contracts this user uploaded.
  investmentReceiptsUploaded  InvestmentReceipt[]  @relation("InvestmentReceiptUploadedBy")
  investmentContractsUploaded InvestmentContract[] @relation("InvestmentContractUploadedBy")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  // SHA-256 hash of the session token. The raw token itself is never
  // stored here -- it only ever lives in the HttpOnly cookie.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Cascade: sessions are ephemeral auth state, not historical/audit
  // data (unlike Sale/Payment, which use the default Restrict), so a
  // deleted user should never leave orphaned session rows behind.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  fullName       String
  // Optional -- not every customer has a cédula/RUC on hand at the time of
  // registration. Still unique when present: Postgres allows any number of
  // NULLs alongside a unique constraint, so existing customers with a
  // cédula are never affected.
  identification String?  @unique
  phone          String
  email          String?
  city           String?
  country        String
  // Optional free-text address. Shared by every module that reuses
  // Customer (Clientes, Inversiones, ...) -- not required, so existing
  // customers never need backfilling.
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // The SELLER responsible for this customer. Required: every customer
  // must have exactly one owner for filtering, sales attribution, and
  // commercial history. A SELLER can only ever be assigned themselves; an
  // ADMIN/ACCOUNTANT picks any active SELLER. Enforced in application
  // logic (src/server/services/customer-service.ts), not just here.
  assignedSellerId String @db.Uuid
  assignedSeller   User   @relation("CustomerAssignedSeller", fields: [assignedSellerId], references: [id])

  sales       Sale[]
  // A customer with no investments is the common case (Investment is an
  // entirely separate, opt-in relationship on top of the same Customer
  // used by Clientes/Ventas) -- never a duplicated "Investor" record.
  investments Investment[]

  @@index([assignedSellerId])
}

model Product {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  // Optional free-text description shown in the Productos catalog and
  // matched by its search box. Never required, so existing products
  // created before this field existed remain valid, unmodified rows.
  description   String?
  officialPrice Decimal     @db.Decimal(12, 2)
  // Free-form currency code (e.g. "USD"). The rest of the app assumes USD
  // throughout (Sale/Payment/Investment store no currency of their own),
  // so this doesn't yet drive any conversion logic -- it only records
  // what currency officialPrice is denominated in, defaulting existing
  // rows to "USD".
  currency  String      @default("USD")
  type      ProductType
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Historical sales referencing this product. A sale keeps its own
  // originalPrice/finalPrice, so changing officialPrice here never
  // affects past sales.
  sales Sale[]
}

model BankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  bankName      String
  // Short internal label shown throughout the UI (e.g. "Ahorros
  // principal") so users can tell apart accounts at the same bank without
  // reading the full account number.
  alias         String
  accountHolder String
  accountType   String
  // Full account number. The UI must mask it (e.g. show only the last 4
  // digits in listings) — this is not enforced at the database level.
  accountNumber String
  // Free-form currency code (e.g. "USD"), mirroring Product.currency.
  currency      String   @default("USD")
  // Optional free-text payment instructions shown to whoever needs to pay
  // into this account (e.g. "Enviar comprobante a contabilidad@...").
  instructions  String?
  active        Boolean  @default(true)
  // Running balance, only ever moved by an atomic `increment` inside the
  // same transaction that creates the corresponding BankTransaction (see
  // src/server/services/payment-service.ts#approvePaymentForUser) --
  // never written directly from a form. Defaults existing accounts to 0,
  // since no balance history exists for them yet.
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments     Payment[]
  sales        Sale[]
  transactions BankTransaction[]
}

model Sale {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  sellerId   String @db.Uuid
  productId  String @db.Uuid
  // The bank account the customer is expected to pay into. Selected by the
  // seller/admin at sale creation time -- this only records *where* the
  // money should land, it never moves BankAccount.balance itself (see
  // BankTransaction). Optional/nullable so sales created before this field
  // existed remain valid, unmodified rows; application logic
  // (sale-service.ts#createSaleForUser) requires it for every new sale.
  bankAccountId String? @db.Uuid

  saleDate DateTime @default(now())

  // Official product price at the moment of the sale (snapshot, so later
  // price changes on Product never alter historical sales).
  originalPrice Decimal @db.Decimal(12, 2)
  // Discount applied to originalPrice. Zero is a valid, common value.
  discount      Decimal @default(0) @db.Decimal(12, 2)
  // Final price actually agreed with the customer (originalPrice - discount,
  // computed and validated by application logic, not by the database).
  finalPrice    Decimal @db.Decimal(12, 2)

  status SaleStatus @default(ACTIVE)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  seller        User           @relation("SaleSeller", fields: [sellerId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])
  bankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id])
  installments  Installment[]
  notifications Notification[]
  // The sale's proof-of-sale document. Required for every new sale (see
  // sale-service.ts#createSaleForUser) -- optional here only so that sales
  // created before this requirement existed remain valid, unmodified rows.
  receipt       SaleReceipt?
  // Bank income movements generated when a payment tied to this sale gets
  // approved (see BankTransaction). Empty for sales with no approved
  // payments yet, or for historical sales with no bankAccountId at all.
  bankTransactions BankTransaction[]

  @@index([customerId])
  @@index([sellerId])
  @@index([bankAccountId])
}

model Installment {
  id                String            @id @default(uuid()) @db.Uuid
  saleId            String            @db.Uuid
  // 1-based position of this installment within its sale (e.g. 1, 2, 3).
  // Business rule "max 3 installments per sale" is enforced in application
  // logic, not in this schema.
  installmentNumber Int
  amount            Decimal           @db.Decimal(12, 2)
  dueDate           DateTime
  status            InstallmentStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sale          Sale           @relation(fields: [saleId], references: [id])
  payments      Payment[]
  notifications Notification[]

  // A sale can't have two installments sharing the same number.
  @@unique([saleId, installmentNumber])
  @@index([saleId])
  @@index([dueDate])
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  installmentId String        @db.Uuid
  // Only required for method = BANK_TRANSFER (enforced in application
  // logic, not here) -- CASH/CARD/OTHER payments have no bank account to
  // record. The "cuentas-bancarias" module isn't built yet either, so a
  // NOT NULL FK here would make it impossible to register any payment.
  bankAccountId String?       @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime
  method        PaymentMethod
  // Optional free-text transaction/voucher reference (e.g. a transfer
  // number), and internal notes about the payment.
  reference     String?
  notes         String?
  // Only meaningful for method = CASH: the name of the person who
  // physically received the money ("Entregado a"), required by
  // application logic whenever a cash payment is registered from the
  // per-cuota "forma de pago" selector (see sale-form.tsx). Optional here
  // so every other method, and every payment registered before this field
  // existed, remains a valid, unmodified row.
  receivedByName String?

  validationStatus PaymentValidationStatus @default(PENDING_VALIDATION)

  // User who registered this payment.
  registeredById  String    @db.Uuid
  // User who approved or rejected this payment (null until validated).
  validatedById   String?   @db.Uuid
  validatedAt     DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installment  Installment     @relation(fields: [installmentId], references: [id])
  bankAccount  BankAccount?    @relation(fields: [bankAccountId], references: [id])
  registeredBy User            @relation("PaymentRegisteredBy", fields: [registeredById], references: [id])
  validatedBy  User?           @relation("PaymentValidatedBy", fields: [validatedById], references: [id])
  receipt      PaymentReceipt?
  // The single bank income movement created when this payment gets
  // approved (see BankTransaction.paymentId, unique -- a payment can never
  // produce more than one movement). Null while pending/rejected, and also
  // null for a payment approved before its sale had a bankAccountId.
  bankTransaction BankTransaction?

  @@index([installmentId])
  @@index([validationStatus])
}

model PaymentReceipt {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @unique @db.Uuid

  fileUrl  String
  fileName String
  // MIME type or extension of the uploaded file (e.g. "image/jpeg",
  // "image/png", "application/pdf"). Kept as a free-form string rather
  // than an enum for flexibility with future formats.
  fileType String

  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  payment    Payment @relation(fields: [paymentId], references: [id])
  uploadedBy User    @relation("ReceiptUploadedBy", fields: [uploadedById], references: [id])
}

// A single movement against a BankAccount's balance -- the audit trail
// behind BankAccount.balance, which is only ever changed together with one
// of these rows, in the same transaction (see
// src/server/services/payment-service.ts#approvePaymentForUser). Today the
// only producer is a Payment getting APPROVED (type INCOME, paymentId set,
// saleId copied from the payment's sale for easy filtering) -- saleId/
// paymentId are both optional so the model can also represent a future
// manual/administrative movement (type EXPENSE, no payment behind it)
// without a schema change.
model BankTransaction {
  id            String              @id @default(uuid()) @db.Uuid
  bankAccountId String              @db.Uuid
  saleId        String?             @db.Uuid
  // Unique, not just indexed: this is what guarantees, at the database
  // level, that an approved payment can never be credited to a bank
  // account twice -- a second attempt fails with a unique-constraint
  // violation even under concurrent requests, which an application-level
  // check alone cannot fully rule out. See approvePaymentForUser for the
  // matching pre-check (a friendlier error) and this constraint as the
  // authoritative backstop.
  paymentId     String?             @unique @db.Uuid
  amount        Decimal             @db.Decimal(12, 2)
  type          BankTransactionType
  description   String?
  createdAt     DateTime            @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  sale        Sale?       @relation(fields: [saleId], references: [id])
  payment     Payment?    @relation(fields: [paymentId], references: [id])

  @@index([bankAccountId])
  @@index([saleId])
}

// The sale's proof-of-sale document (e.g. an invoice or signed order form),
// distinct from PaymentReceipt: a PaymentReceipt backs one installment
// payment and goes through the Comprobantes approve/reject workflow, while
// a SaleReceipt backs the sale itself, is required at creation time, and
// currently has no separate validation workflow -- it's just stored and
// shown on the sale detail page.
model SaleReceipt {
  id     String @id @default(uuid()) @db.Uuid
  saleId String @unique @db.Uuid

  fileUrl  String
  fileName String
  // MIME type of the uploaded file, mirroring PaymentReceipt.fileType.
  fileType String

  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  sale       Sale @relation(fields: [saleId], references: [id])
  uploadedBy User @relation("SaleReceiptUploadedBy", fields: [uploadedById], references: [id])
}

// General (not tied to a specific real-estate project -- Project isn't
// modeled yet) investment from a Customer into the company. Reuses
// Customer for the investor's identity/contact data rather than a
// duplicated Investor table -- see Customer.investments.
model Investment {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  // The SELLER who captured this investment, for traceability. Resolved
  // server-side the same way as Customer.assignedSellerId /
  // Sale.sellerId -- never trusted from the client (see
  // src/server/services/investment-service.ts).
  sellerId   String @db.Uuid

  // USD, same Decimal(12,2) convention as Sale/Payment -- never a float.
  // Server-enforced minimum of 2000.00 (see investment-service.ts).
  principalAmount Decimal @db.Decimal(12, 2)
  // Annual net rate agreed for this investment, as a percentage (13.00 =
  // 13%). Defaults to the company-wide standard but is snapshot per
  // investment at creation time -- later changes to the default never
  // alter an already-created investment's rate. Only ADMIN can set a
  // non-default value; SELLER never sees or edits this field.
  annualRate      Decimal @default(13.00) @db.Decimal(5, 2)

  startDate       DateTime
  // Derived from startDate at creation time (+1 year / +2 years, UTC
  // calendar arithmetic) -- never entered manually, never recomputed
  // later even if startDate could somehow change.
  firstReturnDate DateTime
  maturityDate    DateTime

  status InvestmentStatus @default(PENDING_VALIDATION)

  // Set together when an ADMIN/ACCOUNTANT approves or rejects a
  // PENDING_VALIDATION investment (see investment-service.ts). rejectionReason
  // is required by application logic whenever status becomes REJECTED.
  validatedById   String?   @db.Uuid
  validatedAt     DateTime?
  rejectionReason String?

  // Early administrative cancellation (ADMIN only). Full financial
  // settlement on cancellation is a later phase -- this only records that
  // it happened, when, by whom, and why.
  cancelledById      String?   @db.Uuid
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer @relation(fields: [customerId], references: [id])
  seller      User     @relation("InvestmentSeller", fields: [sellerId], references: [id])
  validatedBy User?    @relation("InvestmentValidatedBy", fields: [validatedById], references: [id])
  cancelledBy User?    @relation("InvestmentCancelledBy", fields: [cancelledById], references: [id])

  // Proof of the incoming funds. Required for every new investment (see
  // investment-service.ts#createInvestmentForUser) -- optional here only
  // so the column itself doesn't force the relation beyond what
  // application logic already guarantees, mirroring SaleReceipt.
  receipt  InvestmentReceipt?
  // Signed contract. Uploaded manually and optional in this phase -- no
  // automatic generation.
  contract InvestmentContract?

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
}

// The investment's proof-of-funds document, mirroring SaleReceipt: required
// at creation time, no separate approve/reject workflow of its own (that's
// what Investment.status/validatedBy/rejectionReason already cover for the
// investment as a whole).
model InvestmentReceipt {
  id           String @id @default(uuid()) @db.Uuid
  investmentId String @unique @db.Uuid

  fileUrl  String
  fileName String
  // MIME type of the uploaded file, mirroring PaymentReceipt/SaleReceipt.
  fileType String

  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  investment Investment @relation(fields: [investmentId], references: [id])
  uploadedBy User       @relation("InvestmentReceiptUploadedBy", fields: [uploadedById], references: [id])
}

// The investment's signed contract. Structurally identical to
// InvestmentReceipt but kept as its own model/column (rather than a
// nullable second file on Investment) since it's optional, uploaded
// separately, and conceptually a different artifact.
model InvestmentContract {
  id           String @id @default(uuid()) @db.Uuid
  investmentId String @unique @db.Uuid

  fileUrl  String
  fileName String
  fileType String

  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  investment Investment @relation(fields: [investmentId], references: [id])
  uploadedBy User       @relation("InvestmentContractUploadedBy", fields: [uploadedById], references: [id])
}

// System-wide settings for the /configuracion module. A deliberate
// singleton: `id` always has the literal value "singleton" and the
// application never creates a second row (see
// system-settings-repository.ts#getSystemSettings, which upserts this
// exact id). Not tied to any User -- these are company-wide preferences,
// not per-user ones (contrast with the personal fields on User/Session
// covered by /perfil).
model SystemSettings {
  id String @id @default("singleton")

  // --- Datos de la empresa ---
  companyName    String  @default("")
  companyTaxId   String  @default("")
  companyEmail   String  @default("")
  companyPhone   String  @default("")
  companyAddress String  @default("")

  // --- Configuración de ventas ---
  // Default currency pre-filled on new sales/products; free-form like
  // Product.currency/BankAccount.currency, not an enum.
  saleDefaultCurrency   String @default("USD")
  // Pre-fills the installment count on a new sale. Doesn't change the
  // "max 3 installments per sale" rule enforced in sale-service.ts.
  saleMaxInstallments   Int    @default(3)
  // Default number of days between the sale date and the first
  // installment's due date, pre-filled on the new-sale form.
  salePaymentTermDays   Int    @default(30)

  // --- Notificaciones ---
  notifyOnNewSale        Boolean @default(true)
  notifyOnPaymentDue     Boolean @default(true)
  notifyOnOverduePayment Boolean @default(true)
  // How many days before an installment's due date a reminder notification
  // should be raised.
  reminderDaysBefore     Int     @default(3)

  // --- Personalización ---
  // Hex color driving the app's primary accent; validated as #RRGGBB in
  // application logic, not at the schema level.
  primaryColor String @default("#4f46e5")
  locale       String @default("es-EC")
  timezone     String @default("America/Guayaquil")

  updatedAt DateTime @updatedAt
}

model Notification {
  id      String           @id @default(uuid()) @db.Uuid
  userId  String           @db.Uuid
  title   String
  message String
  type    NotificationType
  read    Boolean          @default(false)

  relatedSaleId        String? @db.Uuid
  relatedInstallmentId String? @db.Uuid

  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  sale        Sale?        @relation(fields: [relatedSaleId], references: [id])
  installment Installment? @relation(fields: [relatedInstallmentId], references: [id])

  @@index([userId])
  @@index([read])
}
